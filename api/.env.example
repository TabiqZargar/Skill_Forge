# Copy to .env and fill in. Never commit real secrets.

# DigitalOcean Inference (server-side only).
DIGITALOCEAN_INFERENCE_KEY=
DIGITALOCEAN_MODEL=openai-gpt-oss-120b
DIGITALOCEAN_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
DIGITALOCEAN_INFERENCE_TIMEOUT=60

# Comma-separated browser origins allowed by CORS.
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Content guardrails.
SKILLFORGE_MAX_FILES=40
SKILLFORGE_MAX_FILE_BYTES=131072
SKILLFORGE_MAX_TOTAL_BYTES=524288
